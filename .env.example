# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the "anon" (legacy) or "publishable" key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# the "service_role" (legacy) or "secret" key — SERVER ONLY, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Session pooler" connection string (URI), with your database password.
# Used only by `npm run db:migrate` and `npm run db:check`.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Optional: password used by `npm run seed` for the demo accounts (dev only).
# If empty, the seed generates random passwords and writes them to .seed-credentials.local.txt
SEED_DEFAULT_PASSWORD=
